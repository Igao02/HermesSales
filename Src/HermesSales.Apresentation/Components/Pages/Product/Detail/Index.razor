@page "/product/{Id:guid}"
@inherits ProductDetailBase
@rendermode InteractiveServer

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-8 mb-12">
    
    @if (IsLoading)
    {
        <!-- Skeleton Loading -->
        <MudGrid>
            <MudItem xs="12" md="6">
                <div class="skeleton-image" style="height: 400px; border-radius: 16px;"></div>
            </MudItem>
            <MudItem xs="12" md="6">
                <div class="skeleton-title" style="height: 48px; width: 80%; margin-bottom: 16px; border-radius: 8px;"></div>
                <div class="skeleton-text" style="height: 24px; margin-bottom: 12px; border-radius: 8px;"></div>
                <div class="skeleton-text" style="height: 24px; width: 90%; margin-bottom: 12px; border-radius: 8px;"></div>
                <div class="skeleton-text" style="height: 24px; width: 70%; margin-bottom: 24px; border-radius: 8px;"></div>
                <div class="skeleton-price" style="height: 40px; width: 40%; margin-bottom: 24px; border-radius: 8px;"></div>
                <div class="skeleton-button" style="height: 56px; border-radius: 12px;"></div>
            </MudItem>
        </MudGrid>
    }
    else if (Product == null)
    {
        <!-- Product Not Found -->
        <MudPaper Elevation="0" Class="pa-12 text-center" Style="border-radius: 24px; background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
            <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Large" Class="mb-4" Style="color: #f56565; font-size: 64px;" />
            <MudText Typo="Typo.h4" Style="font-weight: 700; color: #2d3748; margin-bottom: 16px;">
                Produto não encontrado
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
                O produto que você está procurando não existe ou foi removido.
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Href="/"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Style="border-radius: 12px; padding: 12px 32px;">
                Voltar para o início
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="6">
            <!-- Coluna da Esquerda - Galeria de Imagens com miniaturas e carrossel de tamanhos fixos -->
            <MudItem xs="12" md="6" lg="5">
                <div class="product-gallery">
    
                    @if (Product.ImageUrls != null && Product.ImageUrls.Any())
                    {
                        <div class="gallery-container">

                            <!-- Thumbnails (lado esquerdo) - TAMANHOS FIXOS E IGUAIS -->
                            @if (Product.ImageUrls.Count() > 1)
                            {
                                <div class="thumbnails-vertical">
                                    @for (int i = 0; i < Product.ImageUrls.Count(); i++)
                                    {
                                        var imageUrl = Product.ImageUrls.ElementAt(i);

                                        <div class="thumbnail @(currentImageIndex == i ? "active" : "")"
                                             @onclick="() => SetCurrentImage(i)">
                                            <img src="@imageUrl" alt="thumbnail" />
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Imagem principal do carrossel - TAMANHO FIXO E IGUAL ENTRE TODAS AS IMAGENS -->
                            <div class="main-image-area">
                                <button class="nav-button nav-prev"
                                        @onclick="PreviousImage"
                                        disabled="@(currentImageIndex == 0)">
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" />
                                </button>

                                <div class="main-image-wrapper">
                                    <img src="@Product.ImageUrls.ToList()[currentImageIndex]"
                                         class="main-image"
                                         @onclick="OpenLightbox" />
                                </div>

                                <button class="nav-button nav-next"
                                        @onclick="NextImage"
                                        disabled="@(currentImageIndex >= Product.ImageUrls.Count() - 1)">
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
                                </button>
                            </div>

                        </div>
                    }
                </div>
            </MudItem>

            <!-- Coluna da Direita - Detalhes do Produto -->
            <MudItem xs="12" md="6" lg="7">
                <MudPaper Elevation="0" Class="pa-6 pa-md-8" Style="border-radius: 28px; background: white; height: 100%;">
                    <!-- Badge de Estoque -->
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mb-3">
                        Em estoque
                    </MudChip>

                    <!-- Nome do Produto -->
                    <MudText Typo="Typo.h3" Style="font-weight: 700; color: #1a202c; margin-bottom: 16px; line-height: 1.2;">
                        @Product.Name
                    </MudText>

                    <!-- Avaliação -->
                    <div class="d-flex align-center gap-2 mb-3">
                        <div class="d-flex">
                            @for (int i = 0; i < 5; i++)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="color: #fbbf24;" />
                            }
                        </div>
                        <MudText Typo="Typo.body2" Style="color: #718096;">
                            (128 avaliações)
                        </MudText>
                    </div>

                    <!-- Preço -->
                    <div class="mb-4">
                        <MudText Typo="Typo.h2" Style="font-weight: 800; color: #2c7da0; margin-bottom: 4px;">
                            @Product.Price.ToString("C")
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color: #48bb78;">
                            @if (Product.StockQuantity > 0)
                            {
                                <span>✓ Em estoque (@Product.StockQuantity unidades disponíveis)</span>
                            }
                            else
                            {
                                <span style="color: #f56565;">✗ Fora de estoque</span>
                            }
                        </MudText>
                    </div>

                    <!-- Descrição -->
                    <div class="mb-6">
                        <MudText Typo="Typo.h6" Style="font-weight: 600; color: #2d3748; margin-bottom: 12px;">
                            Descrição do produto
                        </MudText>
                        <MudText Typo="Typo.body1" Style="color: #4a5568; line-height: 1.6;">
                            @Product.Description
                        </MudText>
                    </div>

                    <!-- Quantidade e Ações -->
                    <div class="mb-6">
                        <MudText Typo="Typo.body2" Style="font-weight: 500; color: #2d3748; margin-bottom: 8px;">
                            Quantidade:
                        </MudText>
                        <div class="d-flex align-center gap-3">
                            <MudNumericField @bind-Value="quantity"
                                             Min="1"
                                             Max="@Product.StockQuantity"
                                             Style="width: 120px;"
                                             Variant="Variant.Outlined"
                                             Density="Density.Default" />
                            
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Large"
                                       Disabled="@(Product.StockQuantity <= 0)"
                                       StartIcon="@Icons.Material.Filled.ShoppingCart"
                                       OnClick="AddToCart"
                                       Style="border-radius: 14px; padding: 12px 32px; font-weight: 600;">
                                Adicionar ao carrinho
                            </MudButton>
                        </div>
                    </div>

                    <!-- Informações adicionais -->
                    <MudDivider Class="my-4" />
                    
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" Style="color: #2c7da0;" />
                            <MudText Typo="Typo.body2" Style="color: #4a5568;">
                                Entrega para todo o Brasil
                            </MudText>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Style="color: #2c7da0;" />
                            <MudText Typo="Typo.body2" Style="color: #4a5568;">
                                Compra segura e garantida
                            </MudText>
                        </div>
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Style="color: #2c7da0;" />
                            <MudText Typo="Typo.body2" Style="color: #4a5568;">
                                Nota fiscal eletrônica
                            </MudText>
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

<!-- Lightbox Modal (imagem ampliada mantendo proporção mas com container fixo) -->
@if (showLightbox && Product != null && Product.ImageUrls != null && Product.ImageUrls.Any())
{
    <div class="lightbox" @onclick="CloseLightbox">
        <button class="lightbox-close" @onclick="CloseLightbox">
            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Medium" />
        </button>
        
        <button class="lightbox-nav lightbox-prev"
                @onclick="PreviousImageLightbox"
                disabled="@(currentImageIndex == 0)">
            <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Large" />
        </button>
        
        <div class="lightbox-image-container" @onclick:stopPropagation="true">
            <img src="@Product.ImageUrls.ElementAt(currentImageIndex)"
                 alt="@Product.Name"
                 class="lightbox-img" />
        </div>
        
        <button class="lightbox-nav lightbox-next"
                @onclick="NextImageLightbox"
                disabled="@(currentImageIndex >= Product.ImageUrls.Count() - 1)">
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Large" />
        </button>
        
        <div class="lightbox-counter">
            @(currentImageIndex + 1) / @Product.ImageUrls.Count()
        </div>
    </div>
}

@code {
    private int quantity = 1;
    private int currentImageIndex = 0;
    private bool showLightbox = false;
    
    private async Task AddToCart()
    {
        Snackbar.Add($"Produto adicionado ao carrinho! Quantidade: {quantity}", Severity.Success);
        // Implemente sua lógica de carrinho aqui
    }
    
    private void SetCurrentImage(int index)
    {
        if (Product != null && Product.ImageUrls != null && index >= 0 && index < Product.ImageUrls.Count())
        {
            currentImageIndex = index;
            StateHasChanged();
        }
    }
    
    private void PreviousImage()
    {
        if (currentImageIndex > 0)
        {
            currentImageIndex--;
            StateHasChanged();
        }
    }
    
    private void NextImage()
    {
        if (Product != null && Product.ImageUrls != null && currentImageIndex < Product.ImageUrls.Count() - 1)
        {
            currentImageIndex++;
            StateHasChanged();
        }
    }
    
    private void PreviousImageLightbox()
    {
        if (currentImageIndex > 0)
        {
            currentImageIndex--;
            StateHasChanged();
        }
    }
    
    private void NextImageLightbox()
    {
        if (Product != null && Product.ImageUrls != null && currentImageIndex < Product.ImageUrls.Count() - 1)
        {
            currentImageIndex++;
            StateHasChanged();
        }
    }
    
    private void OpenLightbox()
    {
        showLightbox = true;
        StateHasChanged();
    }
    
    private void CloseLightbox()
    {
        showLightbox = false;
        StateHasChanged();
    }
}

