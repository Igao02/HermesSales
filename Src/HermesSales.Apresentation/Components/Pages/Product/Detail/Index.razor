@page "/product/{Id:guid}"
@inherits ProductDetailBase
@rendermode InteractiveServer

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-8 mb-16">
    @if (IsLoading)
    {
        <!-- Skeleton Loading -->
        <MudGrid Spacing="6">
            <MudItem xs="12" md="6" lg="5">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="460px" Width="100%" Style="border-radius: 20px;" />
            </MudItem>
            <MudItem xs="12" md="6" lg="7">
                <MudPaper Elevation="0" Class="pa-8" Style="border-radius: 28px; background: white; height: 100%;">
                    <MudSkeleton Width="40%" Height="28px" Class="mb-4" />
                    <MudSkeleton Width="85%" Height="48px" Class="mb-2" />
                    <MudSkeleton Width="60%" Height="48px" Class="mb-6" />
                    <MudSkeleton Width="55%" Height="80px" Class="mb-6" />
                    <MudSkeleton Width="100%" Height="24px" Class="mb-2" />
                    <MudSkeleton Width="90%" Height="24px" Class="mb-2" />
                    <MudSkeleton Width="75%" Height="24px" Class="mb-8" />
                    <MudSkeleton Width="100%" Height="56px" Style="border-radius: 14px;" />
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
    else if (Product == null)
    {
        <MudPaper Elevation="0" Class="pa-16 text-center" Style="border-radius: 28px; background: linear-gradient(135deg, #f0f4f8 0%, #d9e8f0 100%);">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Style="font-size: 72px; color: #2c7da0; opacity: 0.5;" Class="mb-4" />
            <MudText Typo="Typo.h4" Style="font-weight: 700; color: #1a202c; margin-bottom: 12px;">
                Produto não encontrado
            </MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-8">
                O produto que você está procurando não existe ou foi removido.
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Href="/"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Style="border-radius: 14px; padding: 14px 36px; font-weight: 600; text-transform: none; letter-spacing: 0;">
                Voltar para o início
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="6">
            <MudItem xs="12" md="6" lg="5">
                <div class="product-gallery">
                    @if (Product.ImageUrls != null && Product.ImageUrls.Any())
                    {
                        <div class="gallery-container">
                            @if (Product.ImageUrls.Count() > 1)
                            {
                                <div class="thumbnails-vertical">
                                    @for (int i = 0; i < Product.ImageUrls.Count(); i++)
                                    {
                                        var imageUrl = Product.ImageUrls.ElementAt(i);
                                        <div class="thumbnail @(currentImageIndex == i ? "active" : "")"
                                             @onclick="() => SetCurrentImage(i)">
                                            <img src="@imageUrl" alt="Miniatura @(i + 1)" />
                                        </div>
                                    }
                                </div>
                            }
                            <div class="main-image-area">
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                               OnClick="PreviousImage"
                                               Disabled="@(currentImageIndex == 0)"
                                               Class="nav-button nav-prev"
                                               Size="Size.Medium" />

                                <div class="main-image-wrapper">
                                    <img src="@Product.ImageUrls.ToList()[currentImageIndex]"
                                         class="main-image"
                                         alt="@Product.Name"
                                         @onclick="OpenLightbox" />
                                </div>

                                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                               OnClick="NextImage"
                                               Disabled="@(currentImageIndex >= Product.ImageUrls.Count() - 1)"
                                               Class="nav-button nav-next"
                                               Size="Size.Medium" />
                            </div>
                        </div>
                        @if (Product.ImageUrls.Count() > 1)
                        {
                            <div class="d-flex justify-center gap-1 mt-3">
                                @for (int i = 0; i < Product.ImageUrls.Count(); i++)
                                {
                                    var idx = i;
                                    <span class="dot-indicator @(currentImageIndex == idx ? "dot-active" : "")"
                                          @onclick="() => SetCurrentImage(idx)"></span>
                                }
                            </div>
                        }
                    }
                </div>
            </MudItem>

            <MudItem xs="12" md="6" lg="7">
                <MudPaper Elevation="0" Class="product-detail-card pa-6 pa-md-8">
                    <div class="d-flex gap-2 mb-4">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                 Style="border-radius: 8px; font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">
                            Em estoque
                        </MudChip>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                                 Style="border-radius: 8px; font-weight: 600;">
                            Frete grátis
                        </MudChip>
                    </div>

                    <MudText Typo="Typo.h4" Style="font-weight: 700; color: #1a202c; margin-bottom: 12px; line-height: 1.25;">
                        @Product.Name
                    </MudText>

                    <div class="d-flex align-center gap-2 mb-5">
                        <MudRating ReadOnly="true" SelectedValue="5" Size="Size.Small"
                                   FullIcon="@Icons.Material.Filled.Star"
                                   EmptyIcon="@Icons.Material.Outlined.Star"
                                   Style="color: #f59e0b;" />
                        <MudText Typo="Typo.body2" Style="color: #64748b; font-weight: 500;">
                            5.0
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color: #94a3b8;">
                            · 128 avaliações
                        </MudText>
                    </div>

                    <MudPaper Elevation="0" Class="price-block pa-4 mb-5">
                        <MudText Typo="Typo.h3" Style="font-weight: 800; color: #2c7da0; line-height: 1;">
                            @Product.Price.ToString("C")
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color: #64748b; margin-top: 4px; display: block;">
                            à vista no cartão ou boleto
                        </MudText>
                        @if (Product.StockQuantity > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                     Icon="@Icons.Material.Filled.CheckCircleOutline" Class="mt-1 pl-0" Style="margin-left: -4px;">
                                @Product.StockQuantity unidades disponíveis
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                     Icon="@Icons.Material.Filled.Cancel" Class="mt-1 pl-0" Style="margin-left: -4px;">
                                Fora de estoque
                            </MudChip>
                        }
                    </MudPaper>

                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: #374151; margin-bottom: 8px; text-transform: uppercase; font-size: 11px; letter-spacing: 0.8px;">
                        Descrição do produto
                    </MudText>
                    <MudText Typo="Typo.body1" Style="color: #4b5563; line-height: 1.7; margin-bottom: 24px;">
                        @Product.Description
                    </MudText>

                    <MudDivider Class="mb-5" />

                    <MudText Typo="Typo.body2" Style="font-weight: 600; color: #374151; margin-bottom: 10px;">
                        Quantidade
                    </MudText>
                    <div class="d-flex align-center gap-3 mb-3 flex-wrap">
                        <MudNumericField @bind-Value="quantity"
                                         Min="1"
                                         Max="@Product.StockQuantity"
                                         Style="width: 110px;"
                                         Variant="Variant.Outlined"
                                         Density="Density.Comfortable"
                                         Margin="Margin.Dense" />

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   Disabled="@(Product.StockQuantity <= 0)"
                                   StartIcon="@Icons.Material.Filled.ShoppingCart"
                                   OnClick="AddToCart"
                                   Style="border-radius: 14px; padding: 12px 28px; font-weight: 700; text-transform: none; letter-spacing: 0; font-size: 1rem; flex: 1; min-width: 180px;">
                            Adicionar ao carrinho
                        </MudButton>
                    </div>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.FlashOn"
                               Style="border-radius: 14px; padding: 12px; font-weight: 700; text-transform: none; letter-spacing: 0; font-size: 1rem; margin-bottom: 24px;">
                        Comprar agora
                    </MudButton>

                    <MudPaper Elevation="0" Class="info-chips-row pa-4" Style="border-radius: 16px; background: #f8fafc; border: 1px solid #e2e8f0;">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="4">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" Style="color: #2c7da0;" />
                                    <MudText Typo="Typo.caption" Style="color: #374151; font-weight: 500;">
                                        Entrega para todo o Brasil
                                    </MudText>
                                </div>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" Style="color: #2c7da0;" />
                                    <MudText Typo="Typo.caption" Style="color: #374151; font-weight: 500;">
                                        Compra 100% segura
                                    </MudText>
                                </div>
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Style="color: #2c7da0;" />
                                    <MudText Typo="Typo.caption" Style="color: #374151; font-weight: 500;">
                                        Nota fiscal eletrônica
                                    </MudText>
                                </div>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    @if (Product != null)
    {
        <MudPaper Elevation="0" Class="mt-8 ai-chat-card pa-6 pa-md-8">

            <div class="d-flex align-center gap-3 mb-6">
                <MudAvatar Style="background: linear-gradient(135deg, #2c7da0, #1a4f6e); width: 48px; height: 48px;">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Style="color: white; font-size: 24px;" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h5" Style="font-weight: 700; color: #1a202c; line-height: 1.2;">
                        Pergunte sobre este produto
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color: #64748b;">
                        Nossa IA responde com base nas informações cadastradas
                    </MudText>
                </div>
            </div>

            @if (chatMessages.Any())
            {
                <MudPaper Elevation="0" Class="chat-history mb-4"
                          Style="max-height: 420px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; background: #f8fafc; border-radius: 16px; padding: 16px; border: 1px solid #e2e8f0;">
                    @foreach (var message in chatMessages)
                    {
                        @if (message.IsUser)
                        {
                            <div class="d-flex justify-end">
                                <MudPaper Elevation="2" Class="pa-3"
                                          Style="background: linear-gradient(135deg, #2c7da0, #1a4f6e); color: white; border-radius: 18px 18px 4px 18px; max-width: 75%;">
                                    <MudText Typo="Typo.body2" Style="color: white; line-height: 1.5;">@message.Text</MudText>
                                </MudPaper>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-start gap-2 align-start">
                                <MudAvatar Style="background: white; border: 1.5px solid #2c7da0; width: 32px; height: 32px; flex-shrink: 0;">
                                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Style="color: #2c7da0;" />
                                </MudAvatar>
                                <MudPaper Elevation="0" Class="pa-3"
                                          Style="background: white; border-radius: 4px 18px 18px 18px; max-width: 75%; border: 1px solid #e2e8f0;">
                                    <MudText Typo="Typo.body2" Style="color: #2d3748; line-height: 1.6; white-space: pre-line;">@message.Text</MudText>
                                </MudPaper>
                            </div>
                        }
                    }

                    @if (isAiLoading)
                    {
                        <div class="d-flex justify-start gap-2 align-start">
                            <MudAvatar Style="background: white; border: 1.5px solid #2c7da0; width: 32px; height: 32px; flex-shrink: 0;">
                                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Style="color: #2c7da0;" />
                            </MudAvatar>
                            <MudPaper Elevation="0" Class="pa-3"
                                      Style="background: white; border-radius: 4px 18px 18px 18px; border: 1px solid #e2e8f0;">
                                <div class="d-flex gap-1 align-center" style="height: 20px;">
                                    <span class="typing-dot" style="animation-delay: 0s;"></span>
                                    <span class="typing-dot" style="animation-delay: 0.18s;"></span>
                                    <span class="typing-dot" style="animation-delay: 0.36s;"></span>
                                </div>
                            </MudPaper>
                        </div>
                    }
                </MudPaper>
            }

            <div class="d-flex gap-3 align-end">
                <MudTextField @bind-Value="userQuestion"
                              Label="Faça uma pergunta sobre este produto..."
                              Variant="Variant.Outlined"
                              Lines="2"
                              Style="flex: 1;"
                              Disabled="@isAiLoading"
                              OnKeyDown="HandleKeyDown" />

                <MudTooltip Text="Enviar pergunta" Placement="Placement.Top">
                    <MudIconButton Icon="@(isAiLoading ? null : Icons.Material.Filled.Send)"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   Size="Size.Large"
                                   Disabled="@(isAiLoading || string.IsNullOrWhiteSpace(userQuestion))"
                                   OnClick="AskAI"
                                   Style="border-radius: 14px; width: 56px; height: 56px;">
                        @if (isAiLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="color: white;" />
                        }
                    </MudIconButton>
                </MudTooltip>
            </div>

            @if (!chatMessages.Any())
            {
                <div class="mt-4">
                    <MudText Typo="Typo.caption" Style="color: #94a3b8; margin-bottom: 8px; display: block;">
                        Sugestões rápidas
                    </MudText>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var suggestion in quickSuggestions)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Outlined"
                                     Color="Color.Primary"
                                     OnClick="() => AskSuggestion(suggestion)"
                                     Style="cursor: pointer; border-radius: 20px; font-weight: 500;">
                                @suggestion
                            </MudChip>
                        }
                    </div>
                </div>
            }
        </MudPaper>
    }
</MudContainer>

@if (showLightbox && Product != null && Product.ImageUrls != null && Product.ImageUrls.Any())
{
    <div class="lightbox" @onclick="CloseLightbox">
        <MudIconButton Icon="@Icons.Material.Filled.Close"
                       OnClick="CloseLightbox"
                       Class="lightbox-close"
                       Style="position: absolute; top: 20px; right: 20px; color: white;" />

        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                       OnClick="PreviousImageLightbox"
                       Disabled="@(currentImageIndex == 0)"
                       Class="lightbox-nav lightbox-prev"
                       Size="Size.Large"
                       Style="color: white;" />

        <div class="lightbox-image-container" @onclick:stopPropagation="true">
            <img src="@Product.ImageUrls.ElementAt(currentImageIndex)"
                 alt="@Product.Name"
                 class="lightbox-img" />
        </div>

        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                       OnClick="NextImageLightbox"
                       Disabled="@(currentImageIndex >= Product.ImageUrls.Count() - 1)"
                       Class="lightbox-nav lightbox-next"
                       Size="Size.Large"
                       Style="color: white;" />

        <div class="lightbox-counter">
            @(currentImageIndex + 1) / @Product.ImageUrls.Count()
        </div>
    </div>
}
