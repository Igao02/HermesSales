@page "/"
@inherits IndexPageBase
@rendermode InteractiveServer

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-8 mb-12">
    
    <!-- Hero Section com Gradiente -->
    <MudPaper Elevation="0" Class="hero-section pa-8 mb-12" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 24px;">
        <MudContainer MaxWidth="MaxWidth.Large">
            <MudGrid Justify="Justify.Center">
                <MudItem xs="12" md="7">
                    <MudText Typo="Typo.h3" Class="text-white mb-4" Style="font-weight: 800;">
                        Descubra o Novo
                    </MudText>
                    <MudText Typo="Typo.body1" Class="text-white mb-6" Style="opacity: 0.9; max-width: 500px;">
                        Explore nossa coleção exclusiva de produtos selecionados especialmente para você. Qualidade e estilo em um só lugar.
                    </MudText>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   Size="Size.Large"
                                   Class="hero-button"
                                   StartIcon="@Icons.Material.Filled.Explore">
                            Explorar Coleção
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Inherit"
                                   Size="Size.Large"
                                   Class="text-white hero-button-outline"
                                   Style="border-color: rgba(255,255,255,0.3);">
                            Ofertas Especiais
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </MudPaper>

    <!-- Header com Filtros -->
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 800; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-text-fill-color: transparent;">
                Nossos Produtos
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Products.Count() produtos encontrados
            </MudText>
        </div>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/product/create"
                       Class="create-button"
                       Style="border-radius: 12px; padding: 8px 24px;">
                Novo Produto
            </MudButton>
        </MudStack>
    </MudStack>

    @if (IsLoading)
    {
        <MudGrid Spacing="12" Justify="Justify.Center">
            <MudItem xs="12">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </MudItem>
        </MudGrid>
    }
    else if (!Products.Any())
    {
        <MudPaper Elevation="0" Class="empty-state pa-12" Style="border-radius: 24px; background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
            <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" Class="mb-4" Style="color: #667eea; opacity: 0.8;" />
            <MudText Typo="Typo.h5" Style="font-weight: 700; color: #2d3748;">Nenhum produto cadastrado ainda</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">Comece agora mesmo a construir seu catálogo!</MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       Href="/product/create"
                       Style="border-radius: 12px; padding: 12px 32px;">
                Cadastrar Primeiro Produto
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var product in Products)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudPaper Elevation="0"
                              Class="product-card"
                              Style="cursor: pointer; transition: all 0.3s ease; border-radius: 16px; overflow: hidden;"
                              @onclick="() => NavigateToProduct(product.Id)">
                        <div class="product-image-wrapper" Style="position: relative; overflow: hidden;">
                            @if (product.ImageUrls != null && product.ImageUrls.Any())
                            {
                                <MudImage Src="@product.ImageUrls.First()"
                                          Alt="@product.Name"
                                          Class="product-image"
                                          ObjectFit="ObjectFit.Cover"
                                          Style="width: 100%; height: 250px; transition: transform 0.3s ease;"
                                          OnMouseOver="event => event.target.style.transform = 'scale(1.05)'"
                                          OnMouseOut="event => event.target.style.transform = 'scale(1)'" />
                                
                                @if (product.ImageUrls.Count() > 1)
                                {
                                    <MudChip T="int" Size="Size.Small"
                                             Class="image-count-badge"
                                             Style="position: absolute; top: 8px; right: 8px; background: rgba(0,0,0,0.7); color: white; backdrop-filter: blur(4px);">
                                        <MudIcon Icon="@Icons.Material.Filled.Photo" Size="Size.Small" />
                                        <span>@product.ImageUrls.Count()</span>
                                    </MudChip>
                                }
                            }
                            else
                            {
                                <div class="product-image-placeholder" Style="width: 100%; height: 250px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center;">
                                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Primary" />
                                </div>
                            }
                        </div>
                        
                        <div class="product-content" Style="padding: 16px;">
                            <MudText Typo="Typo.h6" Style="font-weight: 600; margin-bottom: 8px; color: #1a1a1a;">
                                @product.Name
                            </MudText>
                            <MudText Typo="Typo.body2" Style="color: #666; margin-bottom: 16px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @product.Description
                            </MudText>
                            
                            <div class="product-footer" Style="display: flex; align-items: center; justify-content: space-between;">
                                <MudText Typo="Typo.h6" Style="color: #667eea; font-weight: 700;">
                                    @product.Price.ToString("C2")
                                </MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart"
                                               Color="Color.Primary"
                                               Size="Size.Medium"
                                               Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 12px; padding: 8px; transition: all 0.3s ease;"
                                               OnClick="() => AddToCart(product.Id)"
                                               OnMouseOver="event => event.currentTarget.style.transform = 'scale(1.1)'"
                                               OnMouseOut="event => event.currentTarget.style.transform = 'scale(1)'" />
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        @if (Products.Count() >= 8)
        {
            <div class="text-center mt-8">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Class="load-more-button"
                           EndIcon="@Icons.Material.Filled.ExpandMore"
                           Style="border-radius: 12px; padding: 12px 32px;">
                    Carregar Mais Produtos
                </MudButton>
            </div>
        }
    }
</MudContainer>