@page "/"
@inherits IndexPageBase
@rendermode InteractiveServer

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-8 mb-12">
    
    <!-- Hero Section com Gradiente -->
    <MudPaper Elevation="0" Class="hero-section pa-8 mb-12" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 24px;">
        <MudContainer MaxWidth="MaxWidth.Large">
            <MudGrid AlignItems="AlignItems.Center" Justify="Justify.Center">
                <MudItem xs="12" md="7">
                    <MudText Typo="Typo.h3" Class="text-white mb-4" Style="font-weight: 800;">
                        Descubra o Novo
                    </MudText>
                    <MudText Typo="Typo.body1" Class="text-white mb-6" Style="opacity: 0.9; max-width: 500px;">
                        Explore nossa coleção exclusiva de produtos selecionados especialmente para você. Qualidade e estilo em um só lugar.
                    </MudText>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled" 
                                  Color="Color.Secondary" 
                                  Size="Size.Large"
                                  Class="hero-button"
                                  StartIcon="@Icons.Material.Filled.Explore">
                            Explorar Coleção
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" 
                                  Color="Color.Inherit" 
                                  Size="Size.Large"
                                  Class="text-white hero-button-outline"
                                  Style="border-color: rgba(255,255,255,0.3);">
                            Ofertas Especiais
                        </MudButton>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="5" Class="hero-image-container">
                    <MudImage Src="https://via.placeholder.com/400x300/ffffff/000000?text=Store" 
                             Alt="Hero Image" 
                             Class="hero-image"
                             Style="border-radius: 20px; transform: rotate(3deg); box-shadow: 0 20px 40px rgba(0,0,0,0.2);" />
                </MudItem>
            </MudGrid>
        </MudContainer>
    </MudPaper>

    <!-- Header com Filtros -->
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-6">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 800; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-text-fill-color: transparent;">
                Nossos Produtos
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @Products.Count() produtos encontrados
            </MudText>
        </div>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.FilterList" 
                          Color="Color.Primary" 
                          Variant="Variant.Outlined"
                          Size="Size.Medium" />
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/product/create"
                       Class="create-button"
                       Style="border-radius: 12px; padding: 8px 24px;">
                Novo Produto
            </MudButton>
        </MudStack>
    </MudStack>

    @if (IsLoading)
    {
        <MudGrid Spacing="4">
            @for (int i = 0; i < 8; i++)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudPaper Elevation="0" Class="skeleton-card">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="280px" Class="rounded-t-lg" Style="border-radius: 20px 20px 0 0;" />
                        <div class="pa-4">
                            <MudSkeleton Width="80%" Height="24px" Class="mb-2" />
                            <MudSkeleton Width="60%" Height="20px" Class="mb-3" />
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudSkeleton Width="40%" Height="28px" />
                                <MudSkeleton Width="40px" Height="40px" Style="border-radius: 50%;" />
                            </MudStack>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
    else if (!Products.Any())
    {
        <MudPaper Elevation="0" Class="empty-state pa-12" Style="border-radius: 24px; background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
            <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" Class="mb-4" Style="color: #667eea; opacity: 0.8;" />
            <MudText Typo="Typo.h5" Style="font-weight: 700; color: #2d3748;">Nenhum produto cadastrado ainda</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">Comece agora mesmo a construir seu catálogo!</MudText>
            <MudButton Variant="Variant.Filled" 
                      Color="Color.Primary" 
                      Size="Size.Large"
                      Href="/product/create"
                      Style="border-radius: 12px; padding: 12px 32px;">
                Cadastrar Primeiro Produto
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var product in Products)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudPaper Elevation="0" Class="product-card" Style="border-radius: 20px; overflow: hidden; background: white;">
                        <div class="product-image-wrapper" 
                             @onmouseenter="() => ShowCarousel(product.Id)" 
                             @onmouseleave="() => HideCarousel(product.Id)">
                            
                            @if (product.ImageUrls != null && product.ImageUrls.Any())
                            {
                                var images = product.ImageUrls.Take(3).ToList();
                                var currentIndex = GetCurrentImageIndex(product.Id);
                                
                                <!-- Imagem Principal -->
                                <div class="carousel-main-container">
                                    <MudImage Src="@images[currentIndex]" 
                                             Alt="@product.Name"
                                             Class="carousel-main-image"
                                             ObjectFit="ObjectFit.Cover" />
                                </div>

                                <!-- Badge de Multiplas Imagens -->
                                @if (images.Count > 1)
                                {
                                    <div class="image-count-badge">
                                        <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Size="Size.Small" />
                                        <span>@images.Count</span>
                                    </div>
                                }

                                <!-- Controles do Carrossel -->
                                @if (images.Count > 1)
                                {
                                    <!-- Dots Indicadores -->
                                    <div class="carousel-dots @(IsCarouselVisible(product.Id) ? "visible" : "")">
                                        @for (int i = 0; i < images.Count; i++)
                                        {
                                            <button class="carousel-dot @(i == currentIndex ? "active" : "")" 
                                                    @onclick="() => SetCurrentImage(product.Id, i)"
                                                    @onclick:stopPropagation="true">
                                            </button>
                                        }
                                    </div>

                                    <!-- Setas de Navegacao -->
                                    <button class="carousel-arrow carousel-arrow-left @(IsCarouselVisible(product.Id) ? "visible" : "")" 
                                            @onclick="() => PreviousImage(product.Id, images.Count)"
                                            @onclick:stopPropagation="true">
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                                    </button>
                                    <button class="carousel-arrow carousel-arrow-right @(IsCarouselVisible(product.Id) ? "visible" : "")" 
                                            @onclick="() => NextImage(product.Id, images.Count)"
                                            @onclick:stopPropagation="true">
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                    </button>

                                    <!-- Thumbnails -->
                                    <div class="carousel-thumbnails @(IsCarouselVisible(product.Id) ? "visible" : "")">
                                        @for (int i = 0; i < images.Count; i++)
                                        {
                                            <div class="carousel-thumbnail @(i == currentIndex ? "active" : "")"
                                                 @onclick="() => SetCurrentImage(product.Id, i)"
                                                 @onclick:stopPropagation="true">
                                                <MudImage Src="@images[i]" 
                                                         Alt="Thumbnail"
                                                         ObjectFit="ObjectFit.Cover" />
                                            </div>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <!-- Placeholder quando nao ha imagens -->
                                <div class="product-image-placeholder">
                                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Default" Style="opacity: 0.3;" />
                                </div>
                            }

                            <!-- Wishlist Button -->
                            <MudIconButton Icon="@Icons.Material.Outlined.FavoriteBorder" 
                                          Size="Size.Small"
                                          Class="wishlist-button"
                                          Style="position: absolute; top: 12px; left: 12px; background: white; border-radius: 50%;"
                                          Color="Color.Default" />
                        </div>
                        
                        <MudCardContent Class="pa-4">
                            <!-- Categoria -->
                            <MudText Typo="Typo.caption" Color="Color.Primary" Class="mb-1" Style="font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">
                                Produto
                            </MudText>

                            <!-- Nome do Produto -->
                            <MudText Typo="Typo.subtitle1" Class="mb-1" Style="font-weight: 700; line-height: 1.4; min-height: 44px;">
                                @product.Name
                            </MudText>

                            <!-- Descricao -->
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3" Style="font-size: 0.875rem; line-height: 1.5; min-height: 42px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @product.Description
                            </MudText>

                            <!-- Avaliacao -->
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                                <MudRating SelectedValue="4" ReadOnly="true" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">(124)</MudText>
                            </MudStack>
                            
                            <!-- Preco e Acao -->
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <div>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Style="text-decoration: line-through; font-size: 0.875rem;">
                                        @product.Price.ToString("C2")
                                    </MudText>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.AddShoppingCart" 
                                              Color="Color.Primary" 
                                              Size="Size.Medium"
                                              Variant="Variant.Filled"
                                              Class="cart-button"
                                              Style="border-radius: 12px; padding: 8px;" />
                            </MudStack>
                        </MudCardContent>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <!-- Load More Button -->
        @if (Products.Count() >= 8)
        {
            <div class="text-center mt-8">
                <MudButton Variant="Variant.Outlined" 
                          Color="Color.Primary" 
                          Size="Size.Large"
                          Class="load-more-button"
                          Style="border-radius: 30px; padding: 12px 40px;">
                    Carregar Mais Produtos
                    <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Class="ml-2" Size="Size.Small" />
                </MudButton>
            </div>
        }
    }
</MudContainer>